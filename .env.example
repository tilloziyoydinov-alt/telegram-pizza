# Vercel'da: Settings → Environment Variables. Lokal: cp .env.example .env.local
BOT_TOKEN=123456789:YOUR_TOKEN_FROM_BOTFATHER
# Neon → Connection string (postgresql://...?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Ixtiyoriy:
# ADMIN_IDS=111111111            # bo'sh bo'lsa — botga birinchi /start yozgan odam admin bo'ladi
# ORDERS_CHAT_ID=-100123456789   # buyurtmalar guruhga borsin desangiz
# WEBAPP_URL=https://...         # Vercel'da avtomatik aniqlanadi
